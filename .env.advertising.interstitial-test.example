# Merge these keys into the backend environment, then restart that backend.
# This is a frequent TEST-CLIENT-ONLY profile, not a public rollout.
ADVERTISING_ENABLED=true
ADVERTISING_INTERSTITIAL_ENABLED=true
ADVERTISING_INTERSTITIAL_TEST_ONLY=true
ADVERTISING_INTERSTITIAL_MIN_SESSION_SECONDS=0
ADVERTISING_INTERSTITIAL_MIN_INTERVAL_SECONDS=15
ADVERTISING_INTERSTITIAL_COMPLETED_FLOWS=1
ADVERTISING_INTERSTITIAL_MAX_PER_SESSION=20
ADVERTISING_INTERSTITIAL_MAX_PER_DAY=20

# After testing, use normal values from .env.advertising.example (maxPerDay=1).
# Set TEST_ONLY=false only when explicitly rolling out to release clients.
