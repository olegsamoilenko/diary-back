# Authenticated Pub/Sub push identity. Copy these to the backend environment
# before deploying the guard. These are identifiers, not credentials.
# Values confirmed from the existing nemory-rtdn-push subscription, 2026-10-29.
GOOGLE_PUBSUB_AUDIENCE=https://nemoryai.com/api/iap/pub-sub
GOOGLE_PUBSUB_SERVICE_ACCOUNT_EMAIL=play-iap-server@nemoryai-publisher.iam.gserviceaccount.com
GOOGLE_PLAY_PACKAGE_NAME=com.soniac12.nemory

# Push endpoint remains https://api.nemoryai.com/iap/pub-sub.
# A custom audience can differ from the endpoint; match Google Cloud exactly.
# No new JSON private key or mobile build is needed. Missing auth settings
# reject this webhook with 503; there is no unsigned fallback.
