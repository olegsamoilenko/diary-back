# Production rollout approved 2026-10-26. Merge into the deployed server env.
# This file is NOT loaded automatically; reload the backend after applying it.
# Requires a live-mode Android client, verified AD_SUPPORTED access and UMP.
ADVERTISING_ENABLED=true
ADVERTISING_NATIVE_TODAY_ENABLED=true
ADVERTISING_INTERSTITIAL_ENABLED=true
ADVERTISING_INTERSTITIAL_TEST_ONLY=false

# At most 1 interstitial per full app launch and 2 per local day/device.
# Returning from background does not start another session.
ADVERTISING_INTERSTITIAL_MIN_SESSION_SECONDS=0
ADVERTISING_INTERSTITIAL_MIN_INTERVAL_SECONDS=180
ADVERTISING_INTERSTITIAL_COMPLETED_FLOWS=1
ADVERTISING_INTERSTITIAL_MAX_PER_SESSION=1
ADVERTISING_INTERSTITIAL_MAX_PER_DAY=2

# Unimplemented placements stay disabled.
ADVERTISING_BANNER_ENABLED=false
ADVERTISING_REWARDED_ENABLED=false
ADVERTISING_REWARDED_INTERSTITIAL_ENABLED=false
ADVERTISING_APP_OPEN_ENABLED=false
