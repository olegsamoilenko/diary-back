# Copy into the server environment; reload the backend after changing values.
# This example is not loaded automatically. All production placements start disabled.
# Enable both the master switch and a placement only when that placement is ready.
ADVERTISING_ENABLED=false
ADVERTISING_NATIVE_TODAY_ENABLED=false

# Interstitial: <=2/day/device, <=1 per full app launch (background does not reset).
ADVERTISING_INTERSTITIAL_ENABLED=false
ADVERTISING_INTERSTITIAL_TEST_ONLY=true
ADVERTISING_INTERSTITIAL_MIN_SESSION_SECONDS=0
ADVERTISING_INTERSTITIAL_MIN_INTERVAL_SECONDS=180
ADVERTISING_INTERSTITIAL_COMPLETED_FLOWS=1
ADVERTISING_INTERSTITIAL_MAX_PER_SESSION=1
ADVERTISING_INTERSTITIAL_MAX_PER_DAY=2

# Reserved formats: no renderer, placement or reward logic is implemented yet.
ADVERTISING_BANNER_ENABLED=false
ADVERTISING_REWARDED_ENABLED=false
ADVERTISING_REWARDED_INTERSTITIAL_ENABLED=false
ADVERTISING_APP_OPEN_ENABLED=false
